# ==============================================================================
# Creekside Apartments - Environment Configuration Template
# ==============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (do NOT commit .env to git)
# 2. Fill in the values for your environment
# 3. For development: Use localhost URLs
# 4. For production: Use Render/cloud URLs
#
# ==============================================================================

# ===== DATABASE =====
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/creekside_apartments

# ===== SERVER =====
# Port for backend server (Render assigns automatically in production)
PORT=10000

# Node environment
NODE_ENV=development

# ===== SECURITY =====
# JWT Secret for signing authentication tokens
# MUST be at least 32 characters in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# ===== CORS =====
# Comma-separated list of allowed origins
# For development: http://localhost:3000
# For production: https://creekside-apartments.onrender.com,https://app.creekside.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== EMAIL SERVICE (SendGrid) =====
# Sign up at https://sendgrid.com
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@creekside-apartments.com

# ===== SMS SERVICE (Twilio) =====
# Sign up at https://www.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1-555-0100

# ===== PHYSICAL MAIL SERVICE (Lob) =====
# Sign up at https://lob.com
LOB_API_KEY=your-lob-api-key-here

# ===== LOGGING =====
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ===== DEPLOYMENT =====
# Render specific - leave as-is
RENDER=true
